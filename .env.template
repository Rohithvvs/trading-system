# Fyers API credentials and TOTP parameters
# Used by root module: fyers_token.py  (distinct from backend.app.models.fyers_token)
# Sprint 2: TOTP login | Sprint 3: transient retry (max 3 attempts, 5–10s jitter)

FYERS_CLIENT_ID=""         # Fyers User ID (e.g. YJ08718)
FYERS_APP_ID=""            # Fyers App ID (e.g. L9NY305RTW-100)

# App secret — either name is accepted by generate_fyers_access_token():
FYERS_APP_SECRET=""        # Preferred name for this module
# FYERS_SECRET_ID=""       # Alias accepted for backend settings.fyers_secret_id parity

FYERS_TOTP_SECRET=""       # Fyers Base32 TOTP Secret Key
FYERS_PIN=""               # Fyers 4-digit or 6-digit numeric PIN
FYERS_REDIRECT_URI="https://trade.fyers.in/api-login/redirect-uri/index.html"

# Optional timeouts / retry budget (seconds; invalid values fall back to defaults)
# FYERS_HTTP_TIMEOUT_SEC=10
# FYERS_SDK_TIMEOUT_SEC=15
# FYERS_RETRY_BUDGET_SEC=35          # SC-003 wall-clock budget for persistent failure
# FYERS_TOTP_WINDOW_SLEEP_CAP_SEC=10 # Cap inner TOTP window wait
# Note: HTTP 429 and 5xx are treated as transient (retried); other 4xx fail fast.

# --- Single-owner security (026-remove-multi-user) ---
# User JWT login/signup is removed. Treat this API as trusted-network only.
APP_ENV=development
# Required when APP_ENV=production (fail-closed):
TOKEN_ENCRYPTION_KEY=""    # Long random secret for Fernet broker token encryption
API_KEY=""                 # Bearer token for diagnostics/operator endpoints
# Security secret key for protected scheduler/internal endpoints
SCHEDULER_SECRET=""
