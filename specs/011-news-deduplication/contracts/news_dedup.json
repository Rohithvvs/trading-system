{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NewsDeduplicationContract",
  "description": "Schema for the input and output payloads of the news deduplication engine",
  "type": "object",
  "properties": {
    "articles": {
      "type": "array",
      "description": "List of news articles representing fetched raw items",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "title",
          "description",
          "source",
          "url",
          "published_at",
          "sentiment_score"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          },
          "sentiment_score": {
            "type": "number",
            "minimum": -1.0,
            "maximum": 1.0
          }
        }
      }
    }
  }
}
